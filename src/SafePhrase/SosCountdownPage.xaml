<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafePhrase.SosCountdownPage" Title="SOS">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,24" Spacing="14" MaximumWidthRequest="480" HorizontalOptions="Fill">
                <Image Source="action_sos.png" BackgroundColor="#B43C47" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" />
                <Border x:Name="CountdownDial" StrokeThickness="3" StrokeShape="RoundRectangle 74"
                        Stroke="{AppThemeBinding Light={StaticResource AlertLight}, Dark={StaticResource AlertDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AlertTintLight}, Dark={StaticResource AlertTintDark}}"
                        WidthRequest="148" HeightRequest="148" HorizontalOptions="Center">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label x:Name="CountdownNumberLabel" Text="5" FontSize="60" FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource AlertLight}, Dark={StaticResource AlertDark}}" HorizontalTextAlignment="Center" />
                        <Label Text="seconds" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Label x:Name="CountdownLabel" Text="Preparing SOS..." Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                <Label x:Name="SosChannelLabel" Text="Your selected channel" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                <Label x:Name="StatusLabel" Text="Getting your location..." Style="{StaticResource MutedText}" />
                <Label Text="Nothing is sent automatically. You press Send in the other app." Style="{StaticResource MutedText}" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Padding="24,8,24,20" Spacing="10" MaximumWidthRequest="480" HorizontalOptions="Fill">
            <Button x:Name="CancelButton" Text="Cancel SOS" ImageSource="action_cancel.png" ContentLayout="Left,8"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" Clicked="OnCancelClicked" />
            <Button x:Name="SendNowButton" Text="Open message now" ImageSource="action_message.png" ContentLayout="Left,8"
                    Clicked="OnSendNowClicked" BackgroundColor="#B43C47" TextColor="White" />
            <Button x:Name="NextWhatsAppButton" Text="Next WhatsApp contact" Clicked="OnNextWhatsAppClicked" IsVisible="False" />
            <Button x:Name="DoneButton" Text="Return to Home" Clicked="OnDoneClicked" IsVisible="False" Style="{StaticResource SecondaryAction}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
