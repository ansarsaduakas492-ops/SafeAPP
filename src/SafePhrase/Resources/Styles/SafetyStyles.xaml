<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="CanvasLight">#F4F7F6</Color>
    <Color x:Key="CanvasDark">#101B1B</Color>
    <Color x:Key="SurfaceDark">#1A2929</Color>
    <Color x:Key="InkLight">#183735</Color>
    <Color x:Key="InkDark">#EDF5F2</Color>
    <Color x:Key="MutedLight">#526B67</Color>
    <Color x:Key="MutedDark">#AEC3BC</Color>
    <Color x:Key="TintLight">#E5F3ED</Color>
    <Color x:Key="TintDark">#233F37</Color>
    <Color x:Key="LineLight">#DCE7E2</Color>
    <Color x:Key="LineDark">#354B45</Color>
    <Color x:Key="AlertLight">#AC343B</Color>
    <Color x:Key="AlertDark">#FFB4B8</Color>
    <Color x:Key="AlertTintLight">#FBEDEF</Color>
    <Color x:Key="AlertTintDark">#40262B</Color>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
    </Style>
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label" BasedOn="{StaticResource PageTitle}">
        <Setter Property="FontSize" Value="19" />
    </Style>
    <Style x:Key="MutedText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="Label" BasedOn="{StaticResource MutedText}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.4" />
    </Style>
    <Style x:Key="SafetyButton" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource CanvasDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SafetyButton}" />
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource SafetyButton}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TintLight}, Dark={StaticResource TintDark}}" />
    </Style>
    <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource SecondaryAction}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <Style x:Key="AlertAction" TargetType="Button" BasedOn="{StaticResource SecondaryAction}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AlertLight}, Dark={StaticResource AlertDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AlertTintLight}, Dark={StaticResource AlertTintDark}}" />
    </Style>
    <Style x:Key="SafetyCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="FieldContainer" TargetType="Border" BasedOn="{StaticResource SafetyCard}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12,4" />
    </Style>
</ResourceDictionary>
