<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafePhrase.MainPage"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="SafePhrase is ready"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Set up your phrase and trusted contacts before using Safety Mode." />
            <Label x:Name="SetupStatusLabel" Text="Checking settings..." />
            <Button Text="Settings" Clicked="OnSettingsClicked" />
            <Button x:Name="SpeechTestButton" Text="Offline speech test" Clicked="OnOfflineSpeechTestClicked" />
            <Button x:Name="TestSosButton" Text="Test SOS" Clicked="OnTestSosClicked" IsEnabled="False" />
            <Button x:Name="StartSafetyButton" Text="Start Safety Mode" Clicked="OnStartSafetyClicked" IsEnabled="False" />
            <Button x:Name="StopSafetyButton" Text="Stop Safety Mode" Clicked="OnStopSafetyClicked" IsEnabled="False" />
            <Label x:Name="SafetyStatusLabel" Text="Safety Mode is stopped." />
            <Label Text="Experimental background listening: start while this screen is open. A detected phrase in the background shows a notification; tap it to open SOS. Do not rely on this prototype for emergencies."
                   FontSize="13" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
