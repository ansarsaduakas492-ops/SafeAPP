<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafePhrase.OfflineSpeechTestPage"
             Title="Offline speech test">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Offline speech experiment" Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="This is a one-session microphone test. It does not activate Safety Mode or send anything." />
            <Button Text="Check / prepare English offline model" Clicked="OnCheckAvailabilityClicked" />
            <Label x:Name="StatusLabel" Text="Check whether English (US) is installed for on-device recognition." />
            <Button x:Name="ListenButton" Text="Listen once in English" Clicked="OnListenClicked" />
            <Button x:Name="StopButton" Text="Stop" Clicked="OnStopClicked" IsEnabled="False" />
            <Label Text="Recognized text" Style="{StaticResource SubHeadline}" />
            <Label x:Name="ResultLabel" Text="(no result yet)" />
            <Label Text="The recognizer is explicitly on-device. We will verify offline operation on your phone before relying on this approach." FontSize="13" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
